Vdd_cp  vdd_cp  0 dc 3.6
Vdd_vco vdd_vco 0 dc 3.6
Vdd_div vdd_div 0 dc 3.6

Vref ref 0 pulse(0 3.6 0 100p 100p 5.323333e-08 1.066667e-07)
Vb0 b0 0 dc 0
Vb1 b1 0 dc 0

Irefbp ibp 0 dc 10u
Irefcp icp 0 dc 10u
Irefbn 0 ibn dc 10u
Irefcn 0 icn dc 10u

XPFD ref fb up dn vdd_pfd 0 pfd
XCP up dn ibp icp ibn icn vctrl vdd_cp 0 cp
XLF vctrl 0 loop_filter
XVCO vctrl b0 b1 clk vdd_vco 0 vco

* ---- arm block begin ----
Vp0 p0 0 dc 0
Vp1 p1 0 dc 0
Vp2 p2 0 dc 0
Vp3 p3 0 dc 0
Vp4 p4 0 dc 0
Vp5 p5 0 dc 0
XDIV clk clk p0 p1 p2 p3 p4 p5 fb divout vdd_div 0 divider_chain
.ic v(xdiv.xd0.xdffq.m)=0 v(xdiv.xd0.xdffq.s)=0 v(xdiv.xd0.xdffm.m)=0 v(xdiv.xd0.xdffm.s)=0
.ic v(xdiv.xd1.xdffq.m)=0 v(xdiv.xd1.xdffq.s)=0 v(xdiv.xd1.xdffm.m)=0 v(xdiv.xd1.xdffm.s)=0
