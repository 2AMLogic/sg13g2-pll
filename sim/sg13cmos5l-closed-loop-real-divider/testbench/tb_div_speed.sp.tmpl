* sg13g2-pll :: sim/sg13cmos5l-closed-loop-real-divider (issue #159) -- supporting
* diagnostic: the committed divider_chain alone, ideal pulse clock at @FCLK@ Hz,
* same rails/word/latch .ic/solver options as the real arm. Nominal corner only.
.lib @PDK_ROOT@/@PDK@/libs.tech/ngspice/models/cornerMOShv.lib mos_tt
.lib @PDK_ROOT@/@PDK@/libs.tech/ngspice/models/cornerRES.lib res_typ
.option scale=1 temp=27
.global sub!
.include div_only.spice
Vsub sub! 0 dc 0
Vdd_div vdd_div 0 dc 3.3
* 50% duty, 80 ps edges (VCO output edges in the loop are of this order)
Vclk clk 0 pulse(0 3.3 0 80p 80p @CH@ @CP@)
Vp0 p0 0 dc 0
Vp1 p1 0 dc 0
Vp2 p2 0 dc 0
Vp3 p3 0 dc 0
Vp4 p4 0 dc 0
Vp5 p5 0 dc 0
XDIV clk clk p0 p1 p2 p3 p4 p5 fb divout vdd_div 0 divider_chain
.ic v(xdiv.xd0.xdffq.m)=0 v(xdiv.xd0.xdffq.s)=0 v(xdiv.xd0.xdffm.m)=0 v(xdiv.xd0.xdffm.s)=0
.ic v(xdiv.xd1.xdffq.m)=0 v(xdiv.xd1.xdffq.s)=0 v(xdiv.xd1.xdffm.m)=0 v(xdiv.xd1.xdffm.s)=0
.ic v(xdiv.xd2.xdffq.m)=0 v(xdiv.xd2.xdffq.s)=0 v(xdiv.xd2.xdffm.m)=0 v(xdiv.xd2.xdffm.s)=0
.ic v(xdiv.xd3.xdffq.m)=0 v(xdiv.xd3.xdffq.s)=0 v(xdiv.xd3.xdffm.m)=0 v(xdiv.xd3.xdffm.s)=0
.ic v(xdiv.xd4.xdffq.m)=0 v(xdiv.xd4.xdffq.s)=0 v(xdiv.xd4.xdffm.m)=0 v(xdiv.xd4.xdffm.s)=0
.ic v(xdiv.xd5.xdffq.m)=0 v(xdiv.xd5.xdffq.s)=0 v(xdiv.xd5.xdffm.m)=0 v(xdiv.xd5.xdffm.s)=0
.ic v(xdiv.xfrt.m)=0 v(xdiv.xfrt.s)=0
.save v(clk) v(fb) i(Vdd_div)
.tran 100p @TSTOP@ 0 100p
.control
run
meas tran i_div avg i(Vdd_div) from=@TAVG0@ to=@TSTOP@
linearize v(clk) v(fb)
wrdata wave.dat v(clk) v(fb)
.endc
.end
