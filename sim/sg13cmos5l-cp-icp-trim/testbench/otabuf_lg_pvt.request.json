{
  "engine": "ngspice",
  "netlist": "tb_cp_otabuf_loopgain.sp",
  "models": {
    "lib": "/home/ubuntu/share/pdk/ihp-sg13cmos5l/libs.tech/ngspice/models/cornerMOShv.lib"
  },
  "analysis": {
    "kind": "ac",
    "args": "dec 20 1e3 1e11"
  },
  "measurements": [
    {
      "name": "a0_db_0p5",
      "unit": "dB",
      "spice": ".meas ac a0_db_0p5 find vdb(x0.vdump) at=1e3"
    },
    {
      "name": "ugf_hz_0p5",
      "unit": "Hz",
      "spice": ".meas ac ugf_hz_0p5 when vdb(x0.vdump)=0"
    },
    {
      "name": "pm_rad_0p5",
      "unit": "rad",
      "spice": ".meas ac pm_rad_0p5 find vp(x0.vdump) when vdb(x0.vdump)=0",
      "limits": {
        "min": 0.785398
      }
    },
    {
      "name": "a0_db_1",
      "unit": "dB",
      "spice": ".meas ac a0_db_1 find vdb(x1.vdump) at=1e3"
    },
