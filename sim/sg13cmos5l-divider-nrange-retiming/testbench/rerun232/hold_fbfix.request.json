{
  "engine": "ngspice",
  "netlist": "hold_fbfix.sp",
  "models": {
    "lib": "/home/ubuntu/share/pdk/ihp-sg13cmos5l/libs.tech/ngspice/models/cornerMOShv.lib"
  },
  "analysis": {
    "kind": "tran",
    "args": "20p 42n"
  },
  "measurements": [
    {
      "name": "q_end",
      "spice": ".meas tran q_end find v(q) at=41.9n",
      "unit": "V"
    },
    {
      "name": "s_end",
      "spice": ".meas tran s_end find v(xdut.s) at=41.9n",
      "unit": "V"
    },
    {
      "name": "t_decay",
      "spice": ".meas tran t_decay when v(q)='0.9*vddp' fall=1 td=2.0n",
      "unit": "s"
    }
  ],
  "options": {
    "osdi_preload": [
      "/home/ubuntu/share/pdk/ihp-sg13cmos5l/libs.tech/ngspice/osdi/psp103.osdi",
