{
  "engine": "ngspice",
  "netlist": "../dut/tb_lock_detector.sp",
  "models": {"pdk": "ihp-sg13cmos5l", "lib": "libs.tech/ngspice/models/cornerMOShv.lib"},
  "corners": {"process": [{"name": "typ", "sections": ["mos_tt", {"lib": "libs.tech/ngspice/models/cornerRES.lib", "section": "res_typ"}, {"lib": "libs.tech/ngspice/models/cornerCAP.lib", "section": "cap_typ"}]}], "temperature_c": [27]},
  "analysis": {"kind": "tran", "args": "100p 16u 0 100p"},
  "measurements": [
    {"name": "lock_cross1_t", "spice": ".meas tran lock_cross1_t when v(lock)=1.65 cross=1"},
    {"name": "lock_cross2_t", "spice": ".meas tran lock_cross2_t when v(lock)=1.65 cross=2"},
    {"name": "idd_lock_avg", "spice": ".meas tran idd_lock_avg avg i(vdd) from=10u to=15u"}
  ],
  "options": {"osdi_preload": ["/home/ubuntu/share/pdk/ihp-sg13cmos5l/libs.tech/ngspice/osdi/psp103.osdi", "/home/ubuntu/share/pdk/ihp-sg13cmos5l/libs.tech/ngspice/osdi/psp103_nqs.osdi", "/home/ubuntu/share/pdk/ihp-sg13cmos5l/libs.tech/ngspice/osdi/mosvar.osdi", "/home/ubuntu/share/pdk/ihp-sg13cmos5l/libs.tech/ngspice/osdi/cap_cmomi.osdi", "/home/ubuntu/share/pdk/ihp-sg13cmos5l/libs.tech/ngspice/osdi/r3_cmc.osdi"], "timeout_s": 1800, "keep_artifacts": true}
}
