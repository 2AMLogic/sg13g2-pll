{
  "engine": "ngspice",
  "backend": "batch",
  "netlist": "../testbench/tb_dff_hold_batch.sp",
  "models": {
    "pdk": "ihp-sg13g2",
    "lib": "libs.tech/ngspice/models/cornerMOShv.lib"
  },
  "corners": {
    "process": [
      "mos_tt",
      "mos_ss",
      "mos_ff",
      "mos_sf",
      "mos_fs"
    ],
    "temperature_c": [
      27
    ],
    "params": {
      "vdd_p": [
        3.3
      ]
    }
  },
  "analysis": {
    "kind": "tran",
    "args": "20p 42n"
  },
  "measurements": [
    {
      "name": "q_end",
      "spice": ".meas tran q_end find v(q) at=41.9n"
    },
    {
      "name": "s_end",
      "spice": ".meas tran s_end find v(xdut.s) at=41.9n"
    },
    {
      "name": "t_decay",
      "spice": ".meas tran t_decay when v(q)='0.9*vdd_p' fall=1 td=2.0n"
    }
  ],
  "options": {
    "osdi_preload": [
      "$PDK_ROOT/ihp-sg13g2/libs.tech/ngspice/osdi/psp103.osdi",
      "$PDK_ROOT/ihp-sg13g2/libs.tech/ngspice/osdi/psp103_nqs.osdi",
      "$PDK_ROOT/ihp-sg13g2/libs.tech/ngspice/osdi/mosvar.osdi",
      "$PDK_ROOT/ihp-sg13g2/libs.tech/ngspice/osdi/r3_cmc.osdi"
    ],
    "timeout_s": 1800,
    "keep_artifacts": true
  }
}
