{
  "engine": "ngspice",
  "backend": "batch",
  "netlist": "../testbench/rerun329/tb_g2_rewired_2p97.sp",
  "models": {
    "pdk": "ihp-sg13g2",
    "lib": "libs.tech/ngspice/models/cornerMOShv.lib"
  },
  "corners": {
    "process": [
      "mos_tt",
      "mos_ff",
      "mos_ss"
    ],
    "temperature_c": [
      -40,
      27,
      125
    ]
  },
  "analysis": {
    "kind": "tran",
    "args": "1n 4u"
  },
  "measurements": [
    {
      "name": "vth_up",
      "spice": ".meas tran vth_up find v(vin) when v(sout)=1.485000 fall=1"
    },
    {
      "name": "vth_dn",
      "spice": ".meas tran vth_dn find v(vin) when v(sout)=1.485000 rise=1"
    }
  ],
  "options": {
    "osdi_preload": [
      "$PDK_ROOT/ihp-sg13g2/libs.tech/ngspice/osdi/psp103.osdi",
      "$PDK_ROOT/ihp-sg13g2/libs.tech/ngspice/osdi/psp103_nqs.osdi",
      "$PDK_ROOT/ihp-sg13g2/libs.tech/ngspice/osdi/mosvar.osdi",
      "$PDK_ROOT/ihp-sg13g2/libs.tech/ngspice/osdi/r3_cmc.osdi"
    ],
    "timeout_s": 900,
    "keep_artifacts": true
  }
}
