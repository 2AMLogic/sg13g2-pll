{
  "engine": "ngspice",
  "netlist": "deck.cir",
  "models": {
    "pdk": "ihp-sg13cmos5l"
  },
  "analysis": {
    "kind": "ac",
    "args": "dec 20 1 1000meg"
  },
  "measurements": [
    {
      "name": "pole_hz_db3",
      "unit": "Hz",
      "spice": ".meas ac pole_hz_db3 WHEN vdb(vdd_vco)=-3.0103 CROSS=1"
    }
  ],
  "options": {
    "osdi_preload": [
      "/home/ubuntu/share/pdk/ihp-sg13cmos5l/libs.tech/ngspice/osdi/cap_cmomi.osdi",
      "/home/ubuntu/share/pdk/ihp-sg13cmos5l/libs.tech/ngspice/osdi/cap_cmomf.osdi",
      "/home/ubuntu/share/pdk/ihp-sg13cmos5l/libs.tech/ngspice/osdi/r3_cmc.osdi"
    ],
    "stage_model_inputs": true,
    "ngspice_init": [
      "set numdgt=12"
    ],
    "timeout_s": 600
  },
  "backend": "batch",
  "batch": {
    "capacity_wait_s": 600
  },
  "corners": {
    "temperature_c": [
      27
    ]
  }
}
